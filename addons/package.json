{
  "name": "idydb-addon",
  "version": "0.1.0",
  "private": true,
  "description": "Node-API bindings for the local IdyDB C++ library",
  "main": "build/Release/idydb.node",
  "gypfile": true,
  "scripts": {
    "install": "node-gyp rebuild",
    "build": "node-gyp rebuild",
    "test": "node --expose-gc test.js",
